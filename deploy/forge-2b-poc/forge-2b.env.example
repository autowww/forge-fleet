# Copy to ~/.config/forge-2b-poc/forge-2b.env on the Fleet host (mode 600). Never commit real values.
# Shared by both containers (compose env_file).

# forge-dcs
DCS_BEARER_TOKEN=replace-with-openssl-rand-hex-24
DCS_TENANT_ID=forge-2b

# forge-2b shim: incoming key Open WebUI uses; outgoing gateway key for forge-llm (:18080)
FORGE_2B_API_KEY=replace-with-openssl-rand-hex-24
FORGE_2B_LLM_API_KEY=replace-with-forge-llm-gateway-bearer
FORGE_2B_BACKEND_MODEL_ID=qwen3.5:2b-q4_K_M
# SEC fair-access policy wants an identifying UA with a contact; keep it shell-safe (no parentheses/quotes)
FORGE_2B_EDGAR_USER_AGENT=forge-2b-poc/0.2 ops@forgesdlc.com
