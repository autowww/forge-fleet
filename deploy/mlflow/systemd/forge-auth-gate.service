[Unit]
Description=Forge auth gate for MLflow
After=network-online.target forge-mlflow.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/forge/.config/forge-auth-gate/gate.env
ExecStart=/usr/bin/python3 /home/forge/deploy/forge-auth-gate/gate.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
