# Copy to .env on Venus (never commit secrets).
MLFLOW_POSTGRES_PASSWORD=
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:CHANGE_ME@postgres:5432/mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_HOST_PORT=5050
MLFLOW_GATE_PORT=5051
MLFLOW_TRACKING_URI=https://mlflow.forgedc.net
MLFLOW_TRACKING_USERNAME=forge
MLFLOW_TRACKING_PASSWORD=

# Service/basic-auth users (create via mlflow auth after first boot)
MLFLOW_ADMIN_USERNAME=admin
MLFLOW_ADMIN_PASSWORD=