# Copy to .env beside compose.yaml on the Fleet host (DEV stack).

# Compose identity — isolated from production forge-market-studio
FORGE_MARKET_COMPOSE_PROJECT=forge-market-studio-dev
FORGE_MARKET_PG_CONTAINER=forge-market-postgres-dev
FORGE_MARKET_APP_CONTAINER=forge-market-app-dev
FORGE_MARKET_APP_IMAGE=forge-market-app:studio
FORGE_MARKET_PGDATA_VOLUME=forge_market_studio_dev_pgdata
FORGE_MARKET_APPDATA_VOLUME=forge_market_studio_dev_data

# forge-market checkout used as docker build context
FORGE_MARKET_ROOT=../../../forge-market
# Filled by rollout-forge-market-studio.sh (absolute path required — dockerfile is relative to FORGE_MARKET_ROOT context)
FORGE_MARKET_DOCKERFILE=

POSTGRES_USER=forge_market
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forge_market
FORGE_MARKET_DATABASE_URL=postgresql://forge_market:change-me@postgres:5432/forge_market

# Loopback ports (compose.granite.yaml) — DEV offsets from prod (19792 / 15432)
FORGE_MARKET_STUDIO_HOST_PORT=19793
FORGE_MARKET_POSTGRES_HOST_PORT=15433

# Optional API auth
FORGE_MARKET_STUDIO_API_TOKEN=

# API-only by default: Studio UI stays on the workstation (--ui-remote thin client).
FORGE_MARKET_API_ONLY=1
INCLUDE_STUDIO_UI=0

# Granite host edge plane (loopback on Fleet host — not inside container)
FORGE_MARKET_CDP_URL=http://host.docker.internal:9222

# Build identity (filled by rollout-forge-market-studio.sh)
FORGE_MARKET_GIT_SHA=

# Secrets — set on Granite host only (never commit real values)
FORGE_MARKET_SEC_CONTACT=you@example.com

# Optional LLM (analysis features)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=ctx-unlim-qwen3-8b:latest
