# Copy beside the gate unit (mode-specific paths on Mercury / Venus).
FORGE_AUTH_GATE_SECRET=
FORGE_AUTH_GATE_PUBLIC_ORIGIN=https://webui.forgedc.net
FORGE_AUTH_GATE_UPSTREAM=http://127.0.0.1:19808
FORGE_AUTH_GATE_LOGIN_ORIGIN=https://login.forgedc.net
FORGE_AUTH_GATE_REDEEM_URL=https://login.forgedc.net/gateway/auth/redeem
FORGE_AUTH_GATE_MODE=webui
FORGE_AUTH_GATE_HOST=127.0.0.1
FORGE_AUTH_GATE_PORT=19809
FORGE_AUTH_GATE_TRUSTED_EMAIL_HEADER=X-Forwarded-Email
FORGE_AUTH_GATE_TRUSTED_NAME_HEADER=X-Forwarded-User
FORGE_AUTH_GATE_MLFLOW_HMAC_SECRET=
# MLflow basic-auth admin, used only to create a user after Google sign-in.
# Or set FORGE_AUTH_GATE_MLFLOW_AUTH_INI to the server basic_auth.ini.
FORGE_AUTH_GATE_MLFLOW_ADMIN_USERNAME=
FORGE_AUTH_GATE_MLFLOW_ADMIN_PASSWORD=
FORGE_AUTH_GATE_MLFLOW_AUTH_INI=