# Copy to .env beside compose.yaml on the Fleet host.

# Runtime environment identity (surfaced in /health)
FORGE_MARKET_ENV=prod

# forge-market checkout used as docker build context
FORGE_MARKET_ROOT=../../../forge-market
# Filled by rollout-forge-market-studio.sh (absolute path to Dockerfile.market-app).
# Empty is OK: compose falls back to forge-market/Dockerfile in the build context.
FORGE_MARKET_DOCKERFILE=

POSTGRES_USER=forge_market
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forge_market
FORGE_MARKET_DATABASE_URL=postgresql://forge_market:change-me@postgres:5432/forge_market

# Loopback ports (compose.granite.yaml)
FORGE_MARKET_STUDIO_HOST_PORT=19792
FORGE_MARKET_POSTGRES_HOST_PORT=15432

# Optional API auth (recommended on Granite)
FORGE_MARKET_STUDIO_API_TOKEN=

# API-only by default: Studio UI stays on the workstation (--ui-remote thin client).
FORGE_MARKET_API_ONLY=1
INCLUDE_STUDIO_UI=0

# Granite host edge plane (loopback on Fleet host — not inside container)
FORGE_MARKET_CDP_URL=http://host.docker.internal:9222  # TradingView harvest only

# IB Gateway stays on the analyst laptop (localhost:4001) — not on Granite.

# Secrets — set on Granite host only (never commit real values)
# Required for live SEC ingest (fair-access User-Agent contact).
FORGE_MARKET_SEC_CONTACT=you@example.com
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=ctx-unlim-qwen3-8b:latest
IBKR_FLEX_TOKEN=
IBKR_FLEX_NAV_QUERY_ID=
IBKR_FLEX_TRADES_QUERY_ID=
IBKR_FLEX_POSITIONS_QUERY_ID=
IBKR_FLEX_CASH_QUERY_ID=

# Granite scheduler env file: ~/.config/forge-fleet/forge-market-granite.env
# Install with forge-fleet/scripts/install-granite-market-scheduler.sh
