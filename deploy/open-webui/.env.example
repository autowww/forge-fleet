# Copy to .env on Granite (never commit secrets).
WEBUI_SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://open_webui:CHANGE_ME@postgres:5432/open_webui
PGVECTOR_DB_URL=postgresql://open_webui:CHANGE_ME@postgres:5432/open_webui
WEBUI_URL=https://webui.forgedc.net
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Web bridges (host loopback / host.docker.internal) — one URL/key pair per pilot account; semicolon-separated.
# Example: http://host.docker.internal:9240/v1;http://host.docker.internal:9241/v1
# Keys: the per-account FORGE_WEB_BRIDGE_BEARER values from ~/.config/forge-open-webui/bridge-<slug>.env
OPENAI_API_BASE_URLS=
OPENAI_API_KEYS=

# Consumer-facing API (R13): per-user Open WebUI API keys, restricted to chat + models.
# Users mint a key in Settings → Account → API keys; apps call POST /api/chat/completions.
ENABLE_API_KEYS=true
ENABLE_API_KEYS_ENDPOINT_RESTRICTIONS=true
API_KEYS_ALLOWED_ENDPOINTS=/api/chat/completions,/api/models

OPEN_WEBUI_PGDATA_VOLUME=forge_open_webui_pgdata
OPEN_WEBUI_DATA_VOLUME=forge_open_webui_data
OPEN_WEBUI_HOST_PORT=19808

# Caddy unified installer (forge-fleet.env on Granite)
OPEN_WEBUI_SITE_ADDRESS=webui.forgedc.net
OPEN_WEBUI_UPSTREAM_PORT=19808
